.site-header {
    background: var(--navbar);
    padding: 0;
}

.site-header__inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
}

.site-header .logo {
    height: 36px;
    width: auto;
}

.site-nav {
    display: flex;
    gap: 32px;
    margin-left: auto;
    margin-right: 32px;
}

.site-nav a {
    color: var(--on-dark);
    opacity: 0.8;
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    transition: opacity 0.15s;
}

.site-nav a:hover {
    opacity: 1;
}

